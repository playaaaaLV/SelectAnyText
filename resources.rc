#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"
IDI_APP ICON "ScreenCopy.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SelectAnyText"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "SelectAnyText"
            VALUE "LegalCopyright", "Copyright (c) 2026 playaaaaLV"
            VALUE "OriginalFilename", "SelectAnyText.exe"
            VALUE "ProductName", "SelectAnyText"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 164, 64
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SelectAnyText"
FONT 10, "Segoe UI"
BEGIN
    CTEXT    "Shortcut", -1, 10, 6, 144, 10
    CONTROL  "", IDC_SHORTCUT, "Static", SS_OWNERDRAW, 10, 18, 144, 20
    LTEXT    "", IDC_STATUS, 10, 43, 144, 10
    CONTROL  "Save", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 54, 43, 56, 16
END
